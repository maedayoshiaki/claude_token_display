{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token_display",
  "version": "0.9.8",
  "identifier": "com.tokendisplay.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "Claude Token Usage",
        "url": "index.html",
        "width": 340,
        "height": 420,
        "minWidth": 1,
        "minHeight": 40,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "token_display 設定",
        "url": "settings.html",
        "width": 400,
        "height": 640,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/maedayoshiaki/claude_token_display/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5N0JGNEQ5NjVDMjdEQjQKUldTMGZjSmwyZlI3cVpUb1E3clFVQWJiYVVsdHpxR2NqRXhVZ0l5U0pzaEtsdUlCYjAvRmNMV24K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
